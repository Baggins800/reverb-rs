# reverb-rs reads the same variables as Laravel Reverb, so an existing
# Laravel .env works unchanged.

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SERVER_PATH=
REVERB_HOST=

REVERB_APP_PING_INTERVAL=60
REVERB_APP_ACTIVITY_TIMEOUT=30
REVERB_APP_MAX_MESSAGE_SIZE=10000
REVERB_APP_MAX_CONNECTIONS=
REVERB_APP_ACCEPT_CLIENT_EVENTS_FROM=members

REVERB_APP_RATE_LIMITING_ENABLED=false
REVERB_APP_RATE_LIMIT_MAX_ATTEMPTS=60
REVERB_APP_RATE_LIMIT_DECAY_SECONDS=60
REVERB_APP_RATE_LIMIT_TERMINATE=false

# Horizontal scaling over Redis. Rust-to-Rust only; see the README.
REVERB_SCALING_ENABLED=false
REVERB_SCALING_CHANNEL=reverb
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Not in Laravel Reverb: reverb-rs specific tuning.
# REVERB_APP_ALLOWED_ORIGINS=*
# REVERB_APPS_FILE=./apps.json
# REVERB_SERVER_TLS_CERT=
# REVERB_SERVER_TLS_KEY=
# REVERB_SEND_QUEUE_DEPTH=1024
# REVERB_WS_READ_BUFFER=1024
# REVERB_WS_WRITE_BUFFER=2048
# REVERB_LISTEN_BACKLOG=4096

# Relay Reverb's events back to a Laravel app (see laravel/).
# REVERB_EVENTS_ENABLED=false
# REVERB_EVENTS_CHANNEL=reverb-rs:events
# REVERB_EVENTS_TYPES=channel_created,channel_removed,connection_pruned
# REVERB_EVENTS_SAMPLE_RATE=1.0
# REVERB_EVENTS_BATCH_SIZE=500
# REVERB_EVENTS_FLUSH_MS=100
# REVERB_EVENTS_QUEUE_DEPTH=100000
# REVERB_MAINTENANCE_INTERVAL=60
