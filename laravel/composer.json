{
    "name": "reverb-rs/laravel",
    "description": "Relays reverb-rs server events onto your Laravel event bus, restoring Pulse, Telescope and custom listeners.",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^10.47|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.47|^11.0|^12.0|^13.0",
        "illuminate/redis": "^10.47|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.47|^11.0|^12.0|^13.0",
        "laravel/reverb": "^1.0|^2.0"
    },
    "autoload": {
        "psr-4": {
            "ReverbRs\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ReverbRs\\ReverbRsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
